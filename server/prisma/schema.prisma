// 資料模型依 docs/DATABASE_DESIGN.md。
// 注意：Inventory.quantity 的 CHECK (quantity >= 0) 以手寫 migration SQL 加入（Prisma schema 不支援 CHECK）。
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum LayoutStatus {
  ACTIVE
  ARCHIVED
}

enum MovementType {
  IN
  OUT
  TRANSFER
  DAMAGE
  ADJUSTMENT
}

enum StocktakeStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  passwordHash String
  displayName  String
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  batches             Batch[]
  movements           StockMovement[]
  submittedStocktakes Stocktake[]     @relation("StocktakeSubmitter")
  reviewedStocktakes  Stocktake[]     @relation("StocktakeReviewer")
  idempotencyKeys     IdempotencyKey[]
}

model Product {
  id                Int           @id @default(autoincrement())
  name              String        @unique
  category          String?
  unit              String
  lowStockThreshold Int           @default(0)
  expiryAlertDays   Int           @default(7)
  status            ProductStatus @default(ACTIVE)
  note              String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  batches    Batch[]
  capacities LocationCapacity[]
  movements  StockMovement[]
}

model Batch {
  id           Int      @id @default(autoincrement())
  batchNo      String   @unique
  productId    Int
  receivedDate DateTime
  expiryDate   DateTime
  initialQty   Int
  note         String?
  createdById  Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id])
  createdBy      User            @relation(fields: [createdById], references: [id])
  inventories    Inventory[]
  movements      StockMovement[]
  stocktakeItems StocktakeItem[]

  @@index([productId, expiryDate])
}

model BatchCounter {
  dateKey String @id
  seq     Int    @default(0)
}

model Warehouse {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  name          String
  width         Int
  height        Int
  layoutJson    String   @default("{}")
  layoutVersion Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  racks      Rack[]
  stocktakes Stocktake[]
}

model Rack {
  id          Int          @id @default(autoincrement())
  warehouseId Int
  code        String
  label       String?
  x           Int
  y           Int
  width       Int
  height      Int
  rotation    Int          @default(0)
  status      LayoutStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  warehouse Warehouse  @relation(fields: [warehouseId], references: [id])
  locations Location[]

  @@unique([warehouseId, code])
}

model Location {
  id              Int          @id @default(autoincrement())
  rackId          Int
  code            String       @unique
  x               Int
  y               Int
  width           Int
  height          Int
  defaultCapacity Int?
  status          LayoutStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  rack           Rack               @relation(fields: [rackId], references: [id])
  capacities     LocationCapacity[]
  inventories    Inventory[]
  movementsFrom  StockMovement[]    @relation("MovementFrom")
  movementsTo    StockMovement[]    @relation("MovementTo")
  stocktakeItems StocktakeItem[]
}

model LocationCapacity {
  id         Int      @id @default(autoincrement())
  locationId Int
  productId  Int
  capacity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([locationId, productId])
}

model Inventory {
  id         Int      @id @default(autoincrement())
  batchId    Int
  locationId Int
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  batch    Batch    @relation(fields: [batchId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([batchId, locationId])
  @@index([locationId])
}

model StockMovement {
  id                   Int          @id @default(autoincrement())
  type                 MovementType
  productId            Int
  batchId              Int
  fromLocationId       Int?
  toLocationId         Int?
  quantity             Int
  fromBeforeQty        Int?
  fromAfterQty         Int?
  toBeforeQty          Int?
  toAfterQty           Int?
  productNameSnapshot  String
  locationCodeSnapshot String
  reason               String?
  referenceType        String?
  referenceId          Int?
  operatorId           Int
  createdAt            DateTime     @default(now())

  product      Product   @relation(fields: [productId], references: [id])
  batch        Batch     @relation(fields: [batchId], references: [id])
  fromLocation Location? @relation("MovementFrom", fields: [fromLocationId], references: [id])
  toLocation   Location? @relation("MovementTo", fields: [toLocationId], references: [id])
  operator     User      @relation(fields: [operatorId], references: [id])

  @@index([type, createdAt])
  @@index([productId])
  @@index([batchId])
  @@index([fromLocationId])
  @@index([toLocationId])
}

model Stocktake {
  id            Int             @id @default(autoincrement())
  status        StocktakeStatus @default(PENDING)
  warehouseId   Int?
  note          String?
  submittedById Int
  submittedAt   DateTime        @default(now())
  reviewedById  Int?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  warehouse   Warehouse?      @relation(fields: [warehouseId], references: [id])
  submittedBy User            @relation("StocktakeSubmitter", fields: [submittedById], references: [id])
  reviewedBy  User?           @relation("StocktakeReviewer", fields: [reviewedById], references: [id])
  items       StocktakeItem[]
}

model StocktakeItem {
  id          Int @id @default(autoincrement())
  stocktakeId Int
  locationId  Int
  batchId     Int
  systemQty   Int
  countedQty  Int
  diff        Int

  stocktake Stocktake @relation(fields: [stocktakeId], references: [id])
  location  Location  @relation(fields: [locationId], references: [id])
  batch     Batch     @relation(fields: [batchId], references: [id])

  @@unique([stocktakeId, locationId, batchId])
}

model IdempotencyKey {
  key          String   @id
  userId       Int
  responseJson String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
