{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhunan-cold-storage",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "WAREHOUSE", "class_name": "WarehouseDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WarehouseDO"] }],
  "observability": { "enabled": true }
  // secrets（wrangler secret put）：JWT_SECRET、SYNC_SECRET；本機放 .dev.vars
}
